    "citeproc": "^2.4.63",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.58.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
