# Copy to .env. Keys stay on the server. You can also configure them in Settings.
PORT=4317
DATA_DIR=./data
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Empty model disables automatic transcription. Endpoint/key can fall back to AI settings.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
